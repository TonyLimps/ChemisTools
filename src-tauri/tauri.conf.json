{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChemisTools",
  "version": "0.1.0",
  "identifier": "org.tonylimps.ChemisTools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChemisTools"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "../public/icon.ico"
    ]
  }
}
